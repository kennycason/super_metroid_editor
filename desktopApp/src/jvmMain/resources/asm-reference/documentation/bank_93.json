    {
      "id": "projectile-runtime.Interpreter.lines",
      "symbol": "ProjectileInstructionHandler",
      "lines": [
        {
          "expectedCode": "PHP"
        },
        {
          "expectedCode": "PHB"
        },
        {
          "expectedCode": "PHK"
        },
        {
          "expectedCode": "PLB"
        },
        {
          "expectedCode": "REP #$30",
          "comment": "Select bank $93 and use word-sized cursors and timers."
        },
        {
          "expectedCode": "LDX.W ProjectileIndex",
          "comment": "Load the shared active-slot word offset."
        },
        {
          "expectedCode": "DEC.W SamusProjectile_InstructionTimers,X",
          "comment": "Tick this slot's current frame duration."
        },
        {
          "expectedCode": "BNE .return",
          "comment": "Keep the current frame until its timer expires."
        },
        {
          "expectedCode": "LDY.W SamusProjectile_InstructionPointers,X",
          "comment": "Load the slot's bank-$93 instruction cursor."
        },
        {
          "expectedCode": ".loop:"
        },
        {
          "expectedCode": "LDA.W $0000,Y",
          "comment": "Read the next command opcode or timed-frame duration."
        },
        {
          "expectedCode": "BPL .timer",
          "comment": "Nonnegative words begin timed eight-byte frame records."
        },
        {
          "expectedCode": "STA.B DP_Temp12",
          "comment": "Preserve the negative command address for indirect dispatch."
        },
        {
          "expectedCode": "INY"
        },
        {
          "expectedCode": "INY",
          "comment": "Advance Y to the command's arguments."
        },
        {
          "expectedCode": "PEA.W .loop-1",
          "comment": "Create a near return that resumes interpretation at the next cursor."
        },
        {
          "expectedCode": "JMP.W (DP_Temp12)",
          "comment": "Dispatch the bank-$93 instruction command."
        },
        {
          "expectedCode": ".timer:"
        },
        {
          "expectedCode": "STA.W SamusProjectile_InstructionTimers,X",
          "comment": "Install the new frame duration."
        },
        {
          "expectedCode": "LDA.W $0002,Y",
          "comment": "Read the frame's spritemap pointer."
        },
        {
          "expectedCode": "STA.W SamusProjectile_SpritemapPointers,X"
        },
        {
          "expectedCode": "LDA.W $0004,Y",
          "comment": "Read packed X radius and the following Y-radius byte."
        },
        {
          "expectedCode": "AND.W #$00FF",
          "comment": "Keep the X radius byte."
        },
        {
          "expectedCode": "STA.W SamusProjectile_XRadii,X"
        },
        {
          "expectedCode": "LDA.W $0005,Y",
          "comment": "Read the unaligned Y radius byte."
        },
        {
          "expectedCode": "AND.W #$00FF"
        },
        {
          "expectedCode": "STA.W SamusProjectile_YRadii,X"
        },
        {
          "expectedCode": "TYA"
        },
        {
          "expectedCode": "CLC"
        },
        {
          "expectedCode": "ADC.W #$0008",
          "comment": "Advance past the complete timed-frame record."
        },
        {
          "expectedCode": "STA.W SamusProjectile_InstructionPointers,X",
          "comment": "Publish the next instruction cursor."
        },
        {
          "expectedCode": ".return:"
        },
        {
          "expectedCode": "PLB"
        },
        {
          "expectedCode": "PLP"
        },
        {
          "expectedCode": "RTL"
        }
      ]
    },
