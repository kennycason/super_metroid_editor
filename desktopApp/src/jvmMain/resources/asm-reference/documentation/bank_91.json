{
  "fileId": "bank_91.asm",
  "documentation": [
    {
      "id": "speed-booster.stage-timers",
      "symbol": "SpeedBoostTimerResetValues",
      "expectedCode": "dw $0001,$0001,$0001,$0001,$0002",
      "paragraphs": [
        "Five timer reload words, indexed by the Speed Booster counter times two.",
        "The first word also initializes the adjacent timer/counter pair: its low",
        "byte is the initial delay and its high byte is the starting counter.",
        "Later reloads are ORed into the low timer byte while preserving the counter."
      ]
    },
    {
      "id": "samus-health.restore",
      "symbol": "Restore_A_Energy_ToSamus",
      "expectedCode": "PHP",
      "paragraphs": [
        "Add the requested energy to the main tank. Overflow beyond MaxEnergy is redirected",
        "into reserve energy up to MaxReserveEnergy; any nonzero reserve fill also changes",
        "an off reserve-tank mode to auto before clamping the main tank."
      ]
    },
    {
      "id": "samus-health.direct-damage",
      "symbol": "Deal_A_Damage_to_Samus",
      "expectedCode": "PHP",
      "paragraphs": [
        "Apply raw damage without suit reduction. Negative input enters the crash handler,",
        "$012C is a retained no-damage sentinel, frozen time suppresses subtraction, and",
        "a result below zero is clamped to exactly zero."
      ]
    },
    {
      "id": "ammo-restoration.missiles",
      "symbol": "Restore_A_Missiles_ToSamus",
      "expectedCode": "PHP",
      "paragraphs": [
        "Add the requested missiles to the live count. Values beyond normal capacity spill",
        "into the otherwise rarely used reserve-missile word before the live count clamps",
        "to maximum. An under-capacity result leaves reserve missiles untouched."
      ]
    },
    {
      "id": "ammo-restoration.missile-reserve-cap",
      "symbol": "Restore_A_Missiles_ToSamus",
      "localLabel": ".lessThan99",
      "expectedCode": "LDA.B DP_Temp12",
      "paragraphs": [
        "Reserve missiles cap at the lesser of 99 and maximum missile capacity. Maximums",
        "below 99 use the equipment capacity; maximums of 99 or more use the hard 99 cap."
      ]
    },
    {
      "id": "ammo-restoration.super-missiles",
      "symbol": "Restore_A_SuperMissiles_ToSamus",
      "expectedCode": "PHP",
      "paragraphs": [
        "Add the requested super missiles and clamp only values strictly above maximum.",
        "Equality returns directly because the provisional live count is already correct."
      ]
    },
    {
      "id": "ammo-restoration.power-bombs",
      "symbol": "Restore_A_PowerBombs_ToSamus",
      "expectedCode": "PHP",
      "paragraphs": [
        "Add the requested power bombs and clamp only values strictly above maximum, using",
        "the same equality-preserving structure as super-missile restoration."
      ]
    },
    {
      "id": "xray-runtime.entry",
      "symbol": "XrayHandler",
      "expectedCode": "PHP",
      "paragraphs": [
        "Run only while time is not already frozen and Dash is held. XraySetup returns carry set after",
        "claiming the X-ray state; only that success path spawns the window HDMA object. A rejected setup",
        "leaves the current gameplay and rendering owners unchanged."
      ]
    },
    {
      "id": "xray-runtime.setup-gates",
      "symbol": "XraySetup",
      "expectedCode": "PHP",
      "paragraphs": [
        "Reject the special bomb-spread/liquid combination, landing poses A4..A7 and E0..E7, non-gameplay",
        "states, an active power-bomb effect, vertical movement, and unsupported previous/current movement",
        "types. Carry clear means no X-ray state was installed."
      ]
    },
    {
      "id": "xray-runtime.setup-state",
      "symbol": "XraySetup",
      "localLabel": ".merge",
      "expectedCode": "LDA.W #$0001",
      "paragraphs": [
        "Freeze time, request the facing-specific standing/crouching X-ray pose, clear both 256-line window",
        "tables to FF, and disable enemy projectiles, PLMs, animated tiles and palette FX. Then build the",
        "three-segment indirect HDMA table and seed angle 40h right or C0h left."
      ]
    },
    {
      "id": "xray-runtime.allowed-movement",
      "symbol": "XraySetup",
      "localLabel": ".allowedPoses",
      "expectedCode": "db $01",
      "paragraphs": [
        "Movement-type table entries classify standing-compatible modes as 1 and crouching as 2. Only",
        "standing, running, crouching and ran-into-a-wall are accepted; the previous movement type must also",
        "have a nonzero entry so X-ray cannot start directly after an incompatible transition."
      ]
    },
    {
      "id": "xray-runtime.restore",
      "symbol": "Set_NonXray_SamusPose",
      "expectedCode": "PHP",
      "paragraphs": [
        "Restore standing or crouching pose from movement type and facing, reinitialize animation/history,",
        "return movement and pose input to their normal handlers, mark the beam closed and compensate Y for",
        "a reduced pose radius. Turning is treated as standing, preserving the known X-ray stand-up glitch."
      ]
    },
    {
      "id": "xray-runtime.restore-owners",
      "symbol": "Set_NonXray_SamusPose",
      "localLabel": ".unfreezeEnvironment",
      "expectedCode": "JSL.L Enable_Enemy_Projectiles",
      "paragraphs": [
        "Release every gameplay subsystem paused by setup: enemy projectiles, PLMs, animated-tile objects",
        "and palette-FX objects. The X-ray HDMA teardown owns the remaining frozen-time/window state."
      ]
    },
    {
      "id": "xray-runtime.pose-input",
      "symbol": "XraySamusPoseInputHandler",
      "expectedCode": "PHP",
      "paragraphs": [
        "Pressing the direction opposite Samus starts the matching standing/crouching turn pose and mirrors",
        "the X-ray angle around 100h. Pose initialization immediately refreshes the previous/last-different",
        "history fields used by the rest of Samus movement."
      ]
    },
    {
      "id": "xray-runtime.turn-completion",
      "symbol": "XraySamusPoseInputHandler",
      "localLabel": ".turningOnGround",
      "expectedCode": "LDA.W SamusAnimationFrame",
      "paragraphs": [
        "Complete the ground turn only at animation frame two with timer one. The source pose determines",
        "standing versus crouching X-ray pose D5/D6 or D9/DA for the new facing, after which pose animation",
        "and history are reinitialized together."
      ]
    }
  ],
  "lineDocumentation": [
    {
      "id": "samus-health.RestoreEnergy.lines",
      "symbol": "Restore_A_Energy_ToSamus",
      "lines": [
        {
          "expectedCode": "PHP"
        },
        {
          "expectedCode": "PHB"
        },
        {
          "expectedCode": "PHK"
        },
        {
          "expectedCode": "PLB",
          "comment": "Preserve status/bank and select bank $91 for health state."
        },
        {
          "expectedCode": "REP #$30",
          "comment": "Use 16-bit health and reserve arithmetic."
        },
        {
          "expectedCode": "STA.B DP_Temp12",
          "comment": "Preserve the requested restoration amount."
        },
        {
          "expectedCode": "LDA.W Energy",
          "comment": "Read current main-tank energy."
        },
        {
          "expectedCode": "CLC"
        },
        {
          "expectedCode": "ADC.B DP_Temp12",
          "comment": "Add the pickup or restoration amount."
        },
        {
          "expectedCode": "STA.W Energy",
          "comment": "Publish the provisional main-tank result."
        },
        {
          "expectedCode": "CMP.W MaxEnergy",
          "comment": "Compare it with main-tank capacity."
        },
        {
          "expectedCode": "BMI .return",
          "comment": "Keep an under-capacity result without touching reserves."
        },
        {
          "expectedCode": "SEC"
        },
        {
          "expectedCode": "SBC.W MaxEnergy",
          "comment": "Calculate energy beyond the main-tank maximum."
        },
        {
          "expectedCode": "CLC"
        },
        {
          "expectedCode": "ADC.W ReserveEnergy",
          "comment": "Redirect that overflow into current reserve energy."
        },
        {
          "expectedCode": "CMP.W MaxReserveEnergy",
          "comment": "Compare with reserve capacity."
        },
        {
          "expectedCode": "BMI .maxReserve",
          "comment": "Keep an under-capacity reserve result."
        },
        {
          "expectedCode": "LDA.W MaxReserveEnergy",
          "comment": "Clamp reserve overflow to its maximum."
        },
        {
          "expectedCode": ".maxReserve:"
        },
        {
          "expectedCode": "STA.W ReserveEnergy",
          "comment": "Publish the resulting reserve amount."
        },
        {
          "expectedCode": "BEQ .maxEnergy",
          "comment": "Do not enable auto mode when reserve capacity is zero."
        },
        {
          "expectedCode": "LDA.W ReserveTankMode",
          "comment": "Read the current off/manual/auto mode."
        },
        {
          "expectedCode": "BNE .maxEnergy",
          "comment": "Preserve either already-enabled mode."
        },
        {
          "expectedCode": "LDA.W #$0001",
          "comment": "Select automatic reserve mode."
        },
        {
          "expectedCode": "STA.W ReserveTankMode",
          "comment": "Enable it after the first nonzero reserve fill."
        },
        {
          "expectedCode": ".maxEnergy:"
        },
        {
          "expectedCode": "LDA.W MaxEnergy",
          "comment": "Recover main-tank capacity."
        },
        {
          "expectedCode": "STA.W Energy",
          "comment": "Clamp provisional main energy to its maximum."
        },
        {
          "expectedCode": ".return:"
        },
        {
          "expectedCode": "PLB"
        },
        {
          "expectedCode": "PLP"
        },
        {
          "expectedCode": "RTL"
        }
      ]
    },
    {
      "id": "samus-health.DealDamage.lines",
      "symbol": "Deal_A_Damage_to_Samus",
      "lines": [
        {
          "expectedCode": "PHP"
        },
        {
          "expectedCode": "PHB"
        },
        {
          "expectedCode": "PHK"
        },
        {
          "expectedCode": "PLB"
        },
        {
          "expectedCode": "REP #$30",
          "comment": "Use signed 16-bit damage and energy checks."
        },
        {
          "expectedCode": "PHX"
        },
        {
          "expectedCode": "STA.B DP_Temp12",
          "comment": "Preserve the raw damage amount."
        },
        {
          "expectedCode": "TAX",
          "comment": "Copy it to X only to set signed processor flags."
        },
        {
          "expectedCode": "BPL .noCrash",
          "comment": "Continue for nonnegative damage."
        },
        {
          "expectedCode": "JML Crash_Handler",
          "comment": "Treat negative raw damage as invalid data."
        },
        {
          "expectedCode": ".noCrash:"
        },
        {
          "expectedCode": "CMP.W #$012C",
          "comment": "Test the retained 300-damage no-op sentinel."
        },
        {
          "expectedCode": "BEQ .noDamage"
        },
        {
          "expectedCode": "LDA.W TimeIsFrozenFlag",
          "comment": "Read the global time-freeze state."
        },
        {
          "expectedCode": "BNE .return",
          "comment": "Suppress raw damage while time is frozen."
        },
        {
          "expectedCode": "LDA.W Energy",
          "comment": "Read current whole energy."
        },
        {
          "expectedCode": "SEC"
        },
        {
          "expectedCode": "SBC.B DP_Temp12",
          "comment": "Subtract raw damage without suit reduction."
        },
        {
          "expectedCode": "STA.W Energy",
          "comment": "Publish the provisional result."
        },
        {
          "expectedCode": "BPL .return",
          "comment": "Keep zero or positive energy."
        },
        {
          "expectedCode": "STZ.W Energy",
          "comment": "Clamp an underflowed result to zero."
        },
        {
          "expectedCode": ".return:"
        },
        {
          "expectedCode": "PLX"
        },
        {
          "expectedCode": "PLB"
        },
        {
          "expectedCode": "PLP"
        },
        {
          "expectedCode": "RTL"
        },
        {
          "expectedCode": ".noDamage:"
        },
        {
          "expectedCode": "NOP",
          "comment": "Retain the original empty 300-damage case."
        },
        {
          "expectedCode": "BRA .return"
        }
      ]
    },
