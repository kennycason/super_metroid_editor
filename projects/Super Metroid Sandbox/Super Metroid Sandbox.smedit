 beam charge no longer does screw attack damage (0x824F5: NOP×3).","enabled":false,"writes":[{"offset":533749,"bytes":[234,234,234]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_infinite_missiles","name":"Infinite Missiles","description":"Missiles never deplete (0x83EBF: CE → AD).","enabled":true,"writes":[{"offset":540351,"bytes":[173]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_infinite_supers","name":"Infinite Super Missiles","description":"Super missiles never deplete (0x83EC4: CE → AD).","enabled":true,"writes":[{"offset":540356,"bytes":[173]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_infinite_pbs","name":"Infinite Power Bombs","description":"Power bombs never deplete (0x8402E: 8D → AD).","enabled":true,"writes":[{"offset":540718,"bytes":[173]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_morph_ball_no_item","name":"Morph Ball Without Item","description":"Allows Morph Ball without collecting it (0x8F7D5: 16 → 00).","enabled":false,"writes":[{"offset":587733,"bytes":[0]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_space_jump_no_item","name":"Space Jump Without Item","description":"Enables space jump without having the item (0x82474: D0 → 80).","enabled":false,"writes":[{"offset":533620,"bytes":[128]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_speed_boost_no_item","name":"Speed Booster Without Item","description":"Samus can run fast without collecting speed booster; no blue echoes until item equipped (0x8178C: 89 → A9).","enabled":false,"writes":[{"offset":530316,"bytes":[169]}],"configType":null,"configValue":null,"configData":null,"customItems":[]},{"id":"hex_no_screen_shake","name":"No Screen Shake","description":"Disables all screen shaking effects globally (0x10BAF: NOP×4).","enabled":false,"writes":[{"offset":6852